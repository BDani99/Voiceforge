# Supabase project (public values, safe for the browser)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# NOTE: the Speechify API key must NEVER be a VITE_* variable.
# It lives only as an Edge Function secret:
#   supabase secrets set SPEECHIFY_API_KEY=<key>
